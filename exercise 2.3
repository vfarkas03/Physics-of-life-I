      "source": [
        "#Zusammensetzung der Population und deren veränderung über die Zeit\n",
        "\n",
        "total = n1 + n2 #weil beide populationen die gleichen resourcen teilen\n",
        "\n",
        "fraction1 = n1 / total\n",
        "fraction2 = n2 / total\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(solution.t, fraction1, label=\"Strain 1\")\n",
        "plt.plot(solution.t, fraction2, label=\"Strain 2\")\n",
        "\n",
        "plt.xlabel(\"Time (min)\")\n",
        "plt.ylabel(\"Fraction of total population\")\n",
        "plt.title(\"Population composition over time\")\n",
        "\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "plt.show()"
