        "#exercise 2\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.integrate import solve_ivp\n",
        "\n",
        "N = 1e9\n",
        "alpha1 = 0.025\n",
        "alpha2 = 0.03\n",
        "T1 = 10\n",
        "T2 = 60\n",
        "n1_0 = 500\n",
        "n2_0 = 500\n",
        "\n",
        "\n",
        "#Modell für 2 bakterienstämme\n",
        "def competition(t, y):\n",
        "  n1, n2 = y\n",
        "\n",
        "  if t < T1:\n",
        "    growth1 = 0\n",
        "  else:\n",
        "    growth1 = alpha1\n",
        "\n",
        "  if t < T2:\n",
        "    growth2 = 0\n",
        "  else:\n",
        "    growth2 = alpha2\n",
        "\n",
        "  dn1dt = growth1 * (1 - (n1 + n2) / N) * n1\n",
        "  dn2dt = growth2 * (1 - (n1 + n2) / N) * n2\n",
        "\n",
        "  return[dn1dt, dn2dt]\n",
        "\n",
        "\n",
        "#Differentialgleichung\n",
        "t = np.linspace(0, 1000, 2000)\n",
        "\n",
        "solution = solve_ivp(\n",
        "    competition,\n",
        "    [0, 1000],\n",
        "    [n1_0, n2_0],\n",
        "    t_eval=t\n",
        ")\n",
        "\n",
        "n1 = solution.y[0]\n",
        "n2 = solution.y[1]\n",
        "\n",
        "\n",
        "#Plot mit Populationsgrössen\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(solution.t, n1, label=\"Strain 1\")\n",
        "plt.plot(solution.t, n2, label=\"Strain 2\")\n",
        "\n",
        "plt.yscale(\"log\")\n",
        "\n",
        "plt.xlabel(\"Time (min)\")\n",
        "plt.ylabel(\"Population size\")\n",
        "plt.title(\"Competition between two bacterial strains\")\n",
        "\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "plt.show()"
      ]
    },
